<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Unlimited Aura | Rare & Niche Fragrances</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant:ital,wght@1,300&family=Inter:wght@300;400&family=Montserrat:wght@600&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-body: #0D0E11;
      --bg-card: #181A20;
      --text-primary: #F3F4F6;
      --text-secondary: #9CA3AF;
      --accent: #06B6D4;
      --border-color: #2D3748;
      
      --font-headline: 'Cinzel', serif;
      --font-heading: 'Montserrat', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-italic: 'Cormorant', serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-body);
      color: var(--text-primary);
      font-family: var(--font-body);
      font-weight: 400;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      cursor: pointer;
      font-family: var(--font-heading);
      border: none;
      outline: none;
      transition: all 0.2s ease-in-out;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    header {
      background-color: var(--bg-body);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-img {
      height: 40px;
      width: auto;
      object-fit: contain;
    }

    .logo-title {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 1.3rem;
      letter-spacing: 2px;
      color: var(--text-primary);
      text-transform: uppercase;
    }

    .logo-subtitle {
      font-family: var(--font-body);
      font-size: 0.65rem;
      letter-spacing: 3px;
      color: var(--text-secondary);
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      list-style: none;
      font-family: var(--font-heading);
      font-size: 0.9rem;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .cart-btn {
      background: transparent;
      color: var(--text-primary);
      font-size: 0.9rem;
      position: relative;
    }

    .cart-badge {
      background-color: var(--accent);
      color: #000;
      font-size: 0.7rem;
      font-weight: bold;
      border-radius: 50%;
      padding: 2px 6px;
      margin-left: 4px;
    }

    .btn-primary {
      background-color: var(--text-primary);
      color: var(--bg-body);
      padding: 10px 22px;
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-primary:hover {
      background-color: var(--accent);
      color: var(--bg-body);
    }

    .hero {
      padding: 90px 20px;
      text-align: center;
      background: radial-gradient(circle at center, rgba(6, 186, 212, 0.05) 0%, rgba(13, 14, 17, 1) 70%);
      border-bottom: 1px solid var(--border-color);
    }

    .hero-tagline {
      font-family: var(--font-italic);
      font-size: 1.4rem;
      font-style: italic;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .hero h1 {
      font-family: var(--font-headline);
      font-size: 3rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      margin-bottom: 15px;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero p {
      color: var(--text-secondary);
      max-width: 550px;
      margin: 0 auto 30px auto;
      font-size: 1rem;
      font-weight: 300;
    }

    .trust-bar {
      display: flex;
      justify-content: space-around;
      padding: 20px 0;
      border-bottom: 1px solid var(--border-color);
      background-color: var(--bg-card);
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title {
      font-family: var(--font-heading);
      font-size: 1.5rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 8px;
    }

    .section-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 30px;
      font-weight: 300;
    }

    .categories-section {
      padding: 60px 0;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .category-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 30px 20px;
      text-align: center;
      border-radius: 6px;
      cursor: pointer;
      transition: border-color 0.2s, transform 0.2s;
    }

    .category-card:hover, .category-card.active {
      border-color: var(--accent);
      transform: translateY(-3px);
    }

    .category-card h3 {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      margin-bottom: 5px;
    }

    .category-card p {
      font-family: var(--font-italic);
      font-size: 1.1rem;
      color: var(--text-secondary);
    }

    .products-section {
      padding: 40px 0 80px 0;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 25px;
    }

    .product-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .badge {
      position: absolute;
      top: 15px;
      right: 15px;
      background-color: rgba(6, 186, 212, 0.15);
      color: var(--accent);
      font-size: 0.7rem;
      font-family: var(--font-heading);
      padding: 4px 8px;
      border-radius: 3px;
      border: 1px solid var(--accent);
      text-transform: uppercase;
      z-index: 2;
    }

    .product-image-container {
      width: 100%;
      height: 200px;
      background-color: #121419;
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 15px;
      border-radius: 4px;
      overflow: hidden;
    }

    .product-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .product-card:hover .product-img {
      transform: scale(1.05);
    }

    .product-brand {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-secondary);
    }

    .product-title {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      margin: 2px 0 8px 0;
    }

    .product-price {
      color: var(--accent);
      font-weight: 600;
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    .product-notes {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 12px;
      height: 38px;
    }

    .size-selector {
      display: flex;
      gap: 6px;
      margin-bottom: 15px;
    }

    .size-btn {
      flex: 1;
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      padding: 4px 0;
      font-size: 0.75rem;
      border-radius: 3px;
    }

    .size-btn.active, .size-btn:hover {
      border-color: var(--accent);
      color: var(--text-primary);
      background-color: rgba(6, 186, 212, 0.1);
    }

    .btn-add-cart {
      width: 100%;
      background-color: transparent;
      border: 1px solid var(--text-primary);
      color: var(--text-primary);
      padding: 10px;
      font-size: 0.8rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-add-cart:hover {
      background-color: var(--text-primary);
      color: var(--bg-body);
    }

    .quiz-banner {
      background: linear-gradient(135deg, #181A20 0%, #0D0E11 100%);
      border: 1px solid var(--border-color);
      padding: 50px 20px;
      text-align: center;
      border-radius: 8px;
      margin-bottom: 80px;
    }

    .quiz-banner h2 {
      font-family: var(--font-headline);
      font-size: 1.8rem;
      margin-bottom: 10px;
    }

    .quiz-banner p {
      color: var(--text-secondary);
      margin-bottom: 20px;
      font-size: 0.95rem;
    }

    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.8);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 40px;
      border-radius: 8px;
      max-width: 500px;
      width: 90%;
      position: relative;
    }

    .close-modal {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 1.5rem;
      color: var(--text-secondary);
      cursor: pointer;
    }

    footer {
      background-color: var(--bg-card);
      border-top: 1px solid var(--border-color);
      padding: 60px 0 20px 0;
      font-size: 0.85rem;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-brand p {
      color: var(--text-secondary);
      margin-top: 15px;
      font-weight: 300;
      max-width: 300px;
    }

    .footer-column h4 {
      font-family: var(--font-heading);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 15px;
      color: var(--text-primary);
    }

    .footer-column ul {
      list-style: none;
    }

    .footer-column li {
      margin-bottom: 10px;
    }

    .footer-column a {
      color: var(--text-secondary);
    }

    .footer-column a:hover {
      color: var(--accent);
    }

    .footer-bottom {
      border-top: 1px solid var(--border-color);
      padding-top: 20px;
      text-align: center;
      color: var(--text-secondary);
      font-size: 0.75rem;
    }

    @media (max-width: 768px) {
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
      .nav-links {
        display: none;
      }
      .hero h1 {
        font-size: 2.2rem;
      }
      .trust-bar {
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="container nav-container">
      <div class="logo">
        <img src="img/website.jpg" alt="Unlimited Aura Logo" class="logo-img">
        <div>
          <div class="logo-title">Unlimited Aura</div>
          <div class="logo-subtitle">Eau de Parfum</div>
        </div>
      </div>
      <ul class="nav-links">
        <li><a href="#">Discoveries</a></li>
        <li><a href="#">Decants</a></li>
        <li><a href="#">Full Bottles</a></li>
        <li><a href="#">About Us</a></li>
      </ul>
      <div class="nav-actions">
        <button class="cart-btn" id="cartBtn">Cart <span class="cart-badge" id="cartCounterDisplay">0</span></button>
        <button class="btn-primary">Sign In</button>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <div class="hero-tagline">Authentic Niche Fragrances</div>
      <h1>Express Your Aura With Unique Scents</h1>
      <p>Explore rare, handcrafted, and niche perfumes in full bottles or custom glass decants (2ml, 5ml, 10ml).</p>
      <button class="btn-primary" onclick="document.getElementById('catalog').scrollIntoView({behavior: 'smooth'})">Shop The Collection</button>
    </div>
  </section>

  <div class="trust-bar container">
    <div class="trust-item">
      <span>🛡️</span>
      <span>100% Guaranteed Authentic</span>
    </div>
    <div class="trust-item">
      <span>🧪</span>
      <span>Custom Glass Decants</span>
    </div>
    <div class="trust-item">
      <span>✈️</span>
      <span>Express Worldwide Shipping</span>
    </div>
  </div>

  <main class="container">
    <section class="categories-section">
      <h2 class="section-title">Explore By Olfactory Family</h2>
      <p class="section-desc">Select a scent profile to filter our curated collection.</p>

      <div class="category-grid">
        <div class="category-card active" data-family="all">
          <h3>All Scents</h3>
          <p>Full Collection</p>
        </div>
        <div class="category-card" data-family="woody">
          <h3>Woody & Smoky</h3>
          <p>Oud, Cedar, Incense</p>
        </div>
        <div class="category-card" data-family="ambery">
          <h3>Ambery & Warm</h3>
          <p>Amber, Vanilla, Spice</p>
        </div>
        <div class="category-card" data-family="fresh">
          <h3>Fresh Citrus</h3>
          <p>Bergamot, Vetiver, Sea</p>
        </div>
        <div class="category-card" data-family="gourmand">
          <h3>Gourmand</h3>
          <p>Coffee, Tonka, Cacao</p>
        </div>
      </div>
    </section>

    <section class="products-section" id="catalog">
      <h2 class="section-title">Featured Discoveries</h2>
      <p class="section-desc">Hand-picked niche selections with visual scent profiles.</p>

      <div class="product-grid" id="mainProductsContainer">
      </div>
    </section>

    <section class="quiz-banner">
      <h2>Find Your Signature Aura</h2>
      <p>Answer 3 short questions and we'll match you with a tailored scent profile.</p>
      <button class="btn-primary" id="openQuizBtn">Start Scent Quiz</button>
    </section>
  </main>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="logo" style="margin-bottom: 10px;">
            <img src="img/website.jpg" alt="Unlimited Aura Logo" class="logo-img">
            <div>
              <div class="logo-title">Unlimited Aura</div>
              <div class="logo-subtitle">Eau de Parfum</div>
            </div>
          </div>
          <p>Curating hard-to-find niche fragrances that let your unique presence leave a lasting aura.</p>
        </div>
        <div class="footer-column">
          <h4>Sitemap</h4>
          <ul>
            <li><a href="#">About Us</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Contact Us</a></li>
          </ul>
        </div>
        <div class="footer-column">
          <h4>Product</h4>
          <ul>
            <li><a href="#">Pricing</a></li>
            <li><a href="#">Reviews & Feedback</a></li>
            <li><a href="#">Decant Guide</a></li>
          </ul>
        </div>
        <div class="footer-column">
          <h4>Follow Us</h4>
          <ul>
            <li><a href="#">Instagram</a></li>
            <li><a href="#">Twitter</a></li>
            <li><a href="#">Facebook</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        &copy; Unlimited Aura. All rights reserved.
      </div>
    </div>
  </footer>

  <div class="modal" id="quizModal">
    <div class="modal-content">
      <span class="close-modal" id="closeQuizBtn">&times;</span>
      <h3 class="section-title" style="margin-bottom: 15px;">Scent Quiz</h3>
      <div id="quizStep">
        <p style="margin-bottom: 15px;">What main impression do you want your fragrance to leave?</p>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <button class="btn-add-cart quiz-option" data-recommend="woody">Mysterious & Bold</button>
          <button class="btn-add-cart quiz-option" data-recommend="fresh">Clean & Energetic</button>
          <button class="btn-add-cart quiz-option" data-recommend="ambery">Warm & Inviting</button>
        </div>
      </div>
    </div>
